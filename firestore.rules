rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. ARTESANOS
    match /artisans/{artisanId} {
      allow read: if true;
      allow create: if request.auth != null;
      // El dueño puede actualizar su tienda; usuarios autenticados pueden actualizar rating y reviewsCount
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // 2. PROYECTOS
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // 3. RESEÑAS DE ARTESANOS
    match /artisan_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // 4. COMENTARIOS DE PROYECTOS
    match /project_comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // 5. PERFILES DE USUARIO
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
