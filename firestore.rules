rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. ARTESANOS: Solo el dueño puede crear/modificar/borrar su perfil de artesano
    // Se permite actualizar rating y reviewsCount si solo se tocan esos campos
    match /artisans/{artisanId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewsCount'])
      );
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // 2. PROYECTOS: Solo usuarios autenticados pueden crear, y solo el dueño del proyecto puede editar/borrar
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // 3. RESEÑAS DE ARTESANOS: Clientes crean reseñas vinculadas a su uid; dueños pueden responder
    match /artisan_reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply'])
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 4. COMENTARIOS DE PROYECTOS: Clientes crean comentarios vinculados a su uid; dueños pueden responder
    match /project_comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply'])
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 5. PERFILES DE USUARIO: Estrictamente privados para escritura/borrado por su propio dueño
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId);
    }
  }
}
